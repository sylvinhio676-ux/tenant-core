# Binaires compilés
*.exe
*.exe~
*.dll
*.so
*.dylib

# Locally built root-level binaries (e.g. `go build -o server ./cmd/server`
# or `go build -o healthcheck ./cmd/healthcheck` run from the repo root).
# Anchored with a leading slash so this only matches these exact files at
# the repo root, not the cmd/server/ or cmd/healthcheck/ source directories.
/server
/healthcheck

# Fichiers de test
*.test
*.out

# Dossiers de dépendances vendor (si utilisé un jour)
vendor/

# Fichiers d'environnement/IDE
.env
.vscode/
.idea/

# Fichiers de coverage
coverage.txt
coverage.html
# doc/
benchemarkRigoureur_profiling.txt

# Claude Code local config/session data
.claude/

# Load test results are machine-specific, never committed
loadtest/results/
